{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SysX",
  "version": "0.1.0",
  "identifier": "com.pixelobject.receiver",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SysX",
        "width": 1000,
        "height": 720,
        "minWidth": 980,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false,
        "backgroundColor": "#0A0D0F"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data: blob:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost ws://127.0.0.1:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": {
      "../dist/config.html": "web-config/config.html",
      "../dist/assets": "web-config/assets",
      "../dist/receiver-mark.svg": "web-config/receiver-mark.svg"
    },
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "category": "DeveloperTool",
    "shortDescription": "SysX realtime computer vision",
    "longDescription": "SysX is a desktop application for continuous image processing and preview.",
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller"
      }
    }
  }
}
