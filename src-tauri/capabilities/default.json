{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Minimal permissions for the Receiver window.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "dialog:allow-save",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        { "name": "binaries/receiver-backend", "sidecar": true }
      ]
    },
    "shell:allow-kill"
  ]
}
