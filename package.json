{
  "name": "receiver-desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm native:dev",
    "build": "pnpm build:desktop",
    "build:desktop": "node scripts/build-rust-backend.mjs --release && cargo build --manifest-path src-tauri/Cargo.toml --release",
    "build:macos": "bash scripts/build-macos.sh",
    "native:dev": "node scripts/build-rust-backend.mjs --debug && cargo run --manifest-path src-tauri/Cargo.toml",
    "native:build": "pnpm build:desktop"
  },
  "devDependencies": {}
}
